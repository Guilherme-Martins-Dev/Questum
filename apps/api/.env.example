# Obrigatório
DATABASE_URL=postgres://questum:questum@localhost:5433/questum
GEMINI_API_KEY=sua-chave-aqui

# Pipeline Python
PYTHON_BIN=python            # "python" no Windows, "python3" no Linux/Mac (default por plataforma)
PIPELINE_DIR=../../pipeline  # opcional — resolvido relativo ao arquivo se omitido
PIPELINE_TIMEOUT_MS=600000   # opcional — mata o pipeline depois disso (default 10min)
PIPELINE_MAX_OUTPUT_BYTES=209715200  # opcional — teto da saída do pipeline (default 200MB)

# Servidor (todos opcionais)
PORT=3333
HOST=127.0.0.1               # use 0.0.0.0 pra expor na rede
CORS_ORIGIN=http://localhost:5173  # lista separada por vírgula
MAX_ARQUIVOS=20

# Banco (opcionais)
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=10
